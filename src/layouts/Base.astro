---
import '@fontsource-variable/fraunces/opsz.css';
import '@fontsource-variable/public-sans/wght.css';
import '../styles/global.css';
import { GA_MEASUREMENT_ID } from '../data/site.mjs';
import { topRated } from '../data/ratings.mjs';
import { loadPublishedFarms } from '../data/farms.mjs';
const hasTop = topRated(loadPublishedFarms(), 1).length > 0;

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  jsonLd?: object | object[];
}
const { title, description, noindex = false, jsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const fullTitle = title === 'grassfed.food' ? title : `${title} | grassfed.food`;
const path = Astro.url.pathname;
const nav = [
  { href: '/farms/', label: 'Find a farm' },
  { href: '/dairy/', label: 'Dairy' },
  { href: '/guides/grass-fed-vs-grass-finished/', label: 'Grass-fed vs finished' },
  { href: '/guides/', label: 'Guides' },
  { href: '/certifications/', label: 'Certifications' },
  { href: '/methodology/', label: 'How we verify' },
];
const ld = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="grassfed.food" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {Astro.slots.has('hero') && <link rel="preload" as="image" href="/art/pasture-hero-1600.webp" imagesrcset="/art/pasture-hero-1600.webp 1600w, /art/pasture-hero-1100.webp 1100w, /art/pasture-hero-700.webp 700w" imagesizes="100vw" type="image/webp" fetchpriority="high" />}
    {ld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
    {GA_MEASUREMENT_ID && (
      <>
        <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_MEASUREMENT_ID}`}></script>
        <script is:inline define:vars={{ id: GA_MEASUREMENT_ID }}>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', id);
        </script>
      </>
    )}
  </head>
  <body class={Astro.slots.has('hero') ? 'has-hero' : undefined}>
    <a class="visually-hidden" href="#main">Skip to content</a>
    <header class="site-header glass">
      <div class="wrap">
        <a class="brand" href="/">grassfed<span>.</span>food</a>
        <nav class="nav" aria-label="Main">
          {nav.map((n) => (
            <a href={n.href} aria-current={path === n.href || (n.href === '/guides/' ? path.startsWith('/guides/') && path !== '/guides/grass-fed-vs-grass-finished/' : path.startsWith(n.href)) ? 'page' : undefined}>{n.label}</a>
          ))}
        </nav>
      </div>
    </header>
    <slot name="hero" />
    <main id="main" class="wrap">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <div class="cols">
          <div>
            <p><strong>grassfed.food</strong></p>
            <p>A directory of US farms selling grass-fed meat and dairy, with every listing checked against the farm's own website.</p>
          </div>
          <div>
            <ul>
              <li><a href="/farms/">Find a farm</a></li>
              <li><a href="/bulk-beef/">Bulk beef by state</a></li>
              {hasTop && <li><a href="/top-rated/">Highest-rated farms</a></li>}
              <li><a href="/guides/">Guides</a></li>
              <li><a href="/certifications/">Certifications</a></li>
            </ul>
          </div>
          <div>
            <ul>
              <li><a href="/methodology/">How we verify</a></li>
              <li><a href="/disclosure/">How we make money</a></li>
              <li><a href="/corrections/">Corrections</a></li>
            </ul>
          </div>
          <div>
            <ul>
              <li><a href="/list-your-farm/">List your farm</a></li>
              <li><a href="/about/">About</a></li>
              <li><a href="/privacy/">Privacy</a></li>
            </ul>
          </div>
        </div>
        <p class="small" style="margin-top:1.5rem">Farm details are reported by farms and checked by us; confirm products and prices with the farm before you buy.</p>
      </div>
    </footer>
  </body>
</html>
