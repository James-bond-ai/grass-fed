---
import Stamp from './Stamp.astro';
import { STATE_BY_ABBR, SPECIES, FEEDING, CERTIFICATIONS } from '../data/states.mjs';
interface Props { farm: any; showState?: boolean }
const { farm, showState = true } = Astro.props;
const st = STATE_BY_ABBR[farm.state];
const certs = (farm.certifications ?? []).filter((c) => CERTIFICATIONS[c.program]);
const ships = (farm.sales_channels ?? []).includes('ships-nationwide');
const pickup = (farm.sales_channels ?? []).some((c) => ['on-farm-store', 'farm-pickup'].includes(c));
---
<li class="farm-row"
  data-species={(farm.species ?? []).join(' ')}
  data-finish={farm.feeding_claim?.category ?? 'unknown'}
  data-certified={certs.length ? '1' : '0'}
  data-bulk={farm.bulk_shares ? '1' : '0'}
  data-ships={ships ? '1' : '0'}
  data-pickup={pickup ? '1' : '0'}>
  <div>
    <h3><a href={`/farm/${farm.slug}/`}>{farm.farm_name}</a></h3>
    <p class="where">{farm.city}{showState && st ? `, ${st.name}` : ''}</p>
    <ul class="tags">
      {farm.feeding_claim?.category === 'grass-finished' && <li class="tag finish">Grass-finished</li>}
      {certs.map((c) => <li class="tag cert">{CERTIFICATIONS[c.program].short}</li>)}
      {(farm.species ?? []).slice(0, 4).map((s) => <li class="tag">{SPECIES[s] ?? s}</li>)}
      {farm.bulk_shares && <li class="tag">Bulk shares</li>}
      {ships && <li class="tag">Ships nationwide</li>}
    </ul>
  </div>
  <Stamp date={farm.last_verified_at} />
</li>
