---
import { SPECIES, DAIRY_PRODUCTS, isOrganic } from '../data/states.mjs';
import { loadPublishedFarms } from '../data/farms.mjs';
// Show the organic filter only once at least one farm has a confirmed organic certification.
const anyOrganic = loadPublishedFarms().some(isOrganic);
interface Props { listId: string; total: number; mode?: 'all' | 'dairy' | 'bulk' }
const { listId, total, mode = 'all' } = Astro.props;
---
<form class="filters" data-filter-for={listId} aria-label="Filter farms">
  {mode === 'dairy' ? (
    <div class="field">
      <label for={`${listId}-product`}>Product</label>
      <select id={`${listId}-product`} name="product">
        <option value="">Any dairy</option>
        {Object.entries(DAIRY_PRODUCTS).map(([k, v]) => <option value={k}>{v}</option>)}
      </select>
    </div>
  ) : mode === 'bulk' ? null : (
    <div class="field">
      <label for={`${listId}-species`}>What you want to buy</label>
      <select id={`${listId}-species`} name="species">
        <option value="">Anything</option>
        {Object.entries(SPECIES).map(([k, v]) => <option value={k}>{v}</option>)}
      </select>
    </div>
  )}
  <div class="field">
    <label for={`${listId}-feed`}>{mode === 'dairy' ? 'Herd feeding' : 'Feeding'}</label>
    <select id={`${listId}-feed`} name="feed">
      <option value="">All farms</option>
      {mode === 'dairy'
        ? <option value="gf">Grass-fed herds only</option>
        : <><option value="gff">Grass-finished available</option><option value="any">Any grass-fed</option></>}
    </select>
  </div>
  <div class="checks">
    {anyOrganic && <label><input type="checkbox" name="organic" /> USDA Organic</label>}
    <label><input type="checkbox" name="certified" /> Grass-fed or welfare certified</label>
    {mode === 'all' && <label><input type="checkbox" name="dairy" /> Sells dairy</label>}
    {mode === 'all' && <label><input type="checkbox" name="bulk" /> Quarter or half shares</label>}
    <label><input type="checkbox" name="delivers" /> Delivers or ships</label>
    <label><input type="checkbox" name="pickup" /> Farm pickup or store</label>
  </div>
</form>
<p class="result-count" aria-live="polite" data-count-for={listId}>{total} {total === 1 ? 'farm' : 'farms'}</p>
<script>
  for (const form of document.querySelectorAll<HTMLFormElement>('form[data-filter-for]')) {
    const id = form.dataset.filterFor!;
    const list = document.getElementById(id);
    const count = document.querySelector(`[data-count-for="${id}"]`);
    if (!list) continue;
    const apply = () => {
      const f = new FormData(form);
      const species = (f.get('species') as string) || '';
      const product = (f.get('product') as string) || '';
      let shown = 0;
      for (const row of list.querySelectorAll<HTMLElement>('.farm-row')) {
        const d = row.dataset;
        const ok =
          (!species || (d.species ?? '').split(' ').includes(species)) &&
          (!product || (d.dairyProducts ?? '').split(' ').includes(product)) &&
          (!f.get('feed') || (f.get('feed') === 'gff' ? ['gff', 'both'].includes(d.feed ?? '') : f.get('feed') === 'gf' ? ['gf', 'gff'].includes(d.feed ?? '') : ['gff', 'both', 'gf', 'grain'].includes(d.feed ?? ''))) &&
          (!f.get('organic') || d.organic === '1') &&
          (!f.get('certified') || d.certified === '1') &&
          (!f.get('dairy') || d.dairy === '1') &&
          (!f.get('bulk') || d.bulk === '1') &&
          (!f.get('delivers') || d.delivers === '1') &&
          (!f.get('pickup') || d.pickup === '1');
        row.hidden = !ok;
        if (ok) shown++;
      }
      if (count) count.textContent = shown === 0
        ? 'No farms match these filters. Clear one to see more.'
        : `${shown} ${shown === 1 ? 'farm' : 'farms'}`;
    };
    form.addEventListener('change', apply);
  }
</script>
