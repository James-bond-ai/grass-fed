---
// Header search button. Without JavaScript it is a plain link to the farm finder;
// SiteSearch.astro upgrades it to a button that opens the search dialog.
// Layout: from 1120px it sits after the nav with its label. Below that it is an
// icon in the top right corner of the header, beside the brand, so the nav keeps
// its own row and its sideways scroll on phones.
---
<a class="ss-trigger" href="/farms/" data-site-search>
  <svg class="ss-trigger-icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    <circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2.2" />
    <path d="M15.5 15.5 21 21" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
  </svg>
  <span class="ss-trigger-label">Search</span>
  <span class="ss-tip" aria-hidden="true">Press <kbd>/</kbd> to search</span>
</a>

<style>
  .ss-trigger {
    position: relative;
    display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem;
    flex: none; height: 40px; min-width: 40px; padding: 0 0.75rem; margin-left: -0.5rem;
    border-radius: 999px; border: 1px solid rgba(31,64,41,0.16);
    background: rgba(255,255,255,0.72); color: var(--pasture-deep);
    font: 500 0.9rem/1 var(--body); text-decoration: none; white-space: nowrap;
    transition: background-color 160ms ease, border-color 160ms ease;
  }
  .ss-trigger:hover { background: #fff; border-color: rgba(47,93,58,0.45); }
  .ss-trigger-icon { flex: none; width: 17px; height: 17px; }

  /* Keyboard hint: a small bubble under the button on hover or keyboard focus,
     only on devices with a mouse and only once the script has set data-ready. */
  .ss-tip {
    position: absolute; top: calc(100% + 8px); right: 0; z-index: 1;
    padding: 0.35rem 0.6rem; border-radius: var(--radius-sm);
    background: var(--pasture-deep); color: #fff; font: 500 0.8rem/1.2 var(--body);
    white-space: nowrap; pointer-events: none; opacity: 0; visibility: hidden;
    box-shadow: 0 6px 16px rgba(24,48,30,0.18);
  }
  .ss-tip kbd {
    display: inline-block; min-width: 1.2em; padding: 0.05em 0.3em; margin: 0 0.1em;
    border: 1px solid rgba(255,255,255,0.55); border-radius: 4px;
    font: 600 0.85em/1.2 var(--body); text-align: center;
  }
  @media (hover: hover) and (pointer: fine) {
    .ss-trigger[data-ready]:hover .ss-tip,
    .ss-trigger[data-ready]:focus-visible .ss-tip { opacity: 1; visibility: visible; }
  }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .ss-tip { transition: opacity 140ms ease 250ms, visibility 0s linear 390ms; }
    .ss-trigger[data-ready]:hover .ss-tip,
    .ss-trigger[data-ready]:focus-visible .ss-tip { transition: opacity 140ms ease 250ms, visibility 0s; }
  }

  /* Below 1120px: icon only, pinned to the top right of the header beside the brand. */
  @media (max-width: 1119px) {
    .ss-trigger { position: absolute; top: 11px; right: var(--gutter); margin: 0; padding: 0; width: 40px; }
    .ss-trigger-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  }
  /* Keep the nav from running under the icon when it shares the brand's row. */
  @media (min-width: 761px) and (max-width: 1119px) {
    :global(.site-header .wrap) { padding-right: calc(var(--gutter) + 48px); }
  }
  @media (max-width: 760px) {
    .ss-trigger { top: 8px; }
  }
</style>
