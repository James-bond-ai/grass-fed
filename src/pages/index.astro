---
import Base from '../layouts/Base.astro';
import TileMap from '../components/TileMap.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import FeedingKey from '../components/FeedingKey.astro';
import { BROWSE } from '../data/browse.mjs';
import { getCollection } from 'astro:content';
import { STATES } from '../data/states.mjs';
import { loadPublishedFarms, farmsByState } from '../data/farms.mjs';
import { fmtDate } from '../data/format.mjs';

const farms = loadPublishedFarms();
const byState = farmsByState(farms);
const counts = Object.fromEntries(Object.entries(byState).map(([k, v]) => [k, v.length]));
const statesWithFarms = STATES.filter((s) => counts[s.abbr]).length;
const browseCounts = Object.fromEntries(BROWSE.map((b) => [b.slug, farms.filter((f) => (f.species ?? []).some((s) => b.species.includes(s))).length]));
const latestCheck = farms.map((f) => f.last_verified_at).sort().at(-1);
const articles = (await getCollection('articles'))
  .sort((a, b) => b.data.updated.getTime() - a.data.updated.getTime())
  .slice(0, 6);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'grassfed.food',
  url: 'https://grassfed.food/',
};
---
<Base title="grassfed.food" description="Find US farms selling grass-fed and grass-finished beef, lamb, bison and dairy. Every listing is checked against the farm's own website and dated." jsonLd={jsonLd}>
  <Hero slot="hero" latestCheck={latestCheck} />
  <section class="why" aria-labelledby="why-title">
    <h2 id="why-title">Why grassfed.food exists</h2>
    <p class="why-lede">Buying grass-fed meat and dairy straight from a farm should be simple. Too often it isn't: labels blur grass-fed and grass-finished, directories are out of date, and it's hard to tell which farms are actually certified.</p>
    <dl class="why-grid">
      <div><dt>Who it's for</dt><dd>Home cooks, families buying a quarter or half of beef, and anyone who wants to know how their food was raised.</dd></div>
      <div><dt>What we do</dt><dd>Check every farm against its own website, confirm certifications at the source, and date every listing.</dd></div>
      <div><dt>What we won't do</dt><dd>Take money from farms or brands for placement, or make health claims.</dd></div>
    </dl>
    <p class="why-more"><a href="/about/">Read more about grassfed.food</a></p>
  </section>
  <FeedingKey />

  <section>
    <h2>What are you looking for?</h2>
    <ul class="species-row">
      {BROWSE.map((b) => (
        <li><a href={b.slug === 'dairy' ? '/dairy/' : `/browse/${b.slug}/`}><Icon name={b.icon} size={44} />{b.label}<small>{browseCounts[b.slug]} {browseCounts[b.slug] === 1 ? 'farm' : 'farms'}</small></a></li>
      ))}
    </ul>
  </section>

  <section>
    <h2>Farms by state</h2>
    <p class="muted">{farms.length} verified {farms.length === 1 ? 'farm' : 'farms'} based in {statesWithFarms} {statesWithFarms === 1 ? 'state' : 'states'} so far, with more added every week.</p>
    <TileMap />
  </section>

  <section class="prose">
    <h2>How a farm gets listed</h2>
    <ol class="steps">
      <li><strong>We find it</strong> through certifier listings, USDA local food data, state agriculture programs, or the farm itself.</li>
      <li><strong>We check the farm's own website</strong> for what it sells, how it sells, and how it describes its feeding, in its own words.</li>
      <li><strong>We confirm certifications</strong> in the certifier's own public listing before showing a badge.</li>
      <li><strong>We recheck every listing</strong> on a schedule. Anything we can't confirm comes down.</li>
    </ol>
    <p><a href="/methodology/">Read the full method</a></p>
  </section>

  {articles.length > 0 && (
    <section>
      <h2>Buying guides</h2>
      <ul class="article-list">
        {articles.map((a) => (
          <li><a href={`/guides/${a.id}/`}>{a.data.title}</a><p>{a.data.description}</p></li>
        ))}
      </ul>
    </section>
  )}
</Base>

<style>
  .why { margin: 0 0 2rem; }
  .why h2 { margin-top: 0.5rem; }
  .why-lede { max-width: 62ch; font-size: 1.1rem; }
  .why-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem 2rem; margin: 1.25rem 0 0.75rem; }
  .why-grid div { border-top: 3px solid var(--pasture); padding-top: 0.6rem; }
  .why-grid dt { font-family: var(--display); font-weight: 700; font-size: 1.15rem; color: var(--pasture-deep); margin-bottom: 0.3rem; }
  .why-grid dd { margin: 0; color: var(--ink-soft); }
  .why-more { margin: 0.25rem 0 0; }
  .steps { padding-left: 1.3rem; }
  .steps li { margin-bottom: 0.7rem; padding-left: 0.3rem; }
  .steps li::marker { font-family: var(--display); font-weight: 700; color: var(--hay); }
</style>
