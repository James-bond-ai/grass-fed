---
import Base from '../layouts/Base.astro';
import TileMap from '../components/TileMap.astro';
import Hero from '../components/Hero.astro';
import Icon from '../components/Icon.astro';
import FeedingKey from '../components/FeedingKey.astro';
import { BROWSE } from '../data/browse.mjs';
import { getCollection } from 'astro:content';
import { STATES } from '../data/states.mjs';
import { loadPublishedFarms, farmsByState } from '../data/farms.mjs';
import { topRated, TOP_MIN_REVIEWS } from '../data/ratings.mjs';
import GoogleRating from '../components/GoogleRating.astro';
import ProofBand from '../components/home/ProofBand.astro';
import FreshStrip from '../components/home/FreshStrip.astro';

const farms = loadPublishedFarms();
const byState = farmsByState(farms);
const counts = Object.fromEntries(Object.entries(byState).map(([k, v]) => [k, v.length]));
const statesWithFarms = STATES.filter((s) => counts[s.abbr]).length;
const browseCounts = Object.fromEntries(BROWSE.map((b) => [b.slug, farms.filter((f) => (f.species ?? []).some((s) => b.species.includes(s))).length]));
const latestCheck = farms.map((f) => f.last_verified_at).sort().at(-1);
const articles = (await getCollection('articles'))
  .sort((a, b) => b.data.updated.getTime() - a.data.updated.getTime())
  .slice(0, 6);

const top3 = topRated(farms, 3);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'grassfed.food',
  url: 'https://grassfed.food/',
};
---
<Base title="grassfed.food" description="Find US farms selling grass-fed and grass-finished beef, lamb, bison and dairy. Every listing is checked against the farm's own website and dated." jsonLd={jsonLd}>
  <Hero slot="hero" latestCheck={latestCheck} />

  <ProofBand farms={farms} />
  <FreshStrip farms={farms} />

  <section class="why" aria-labelledby="why-title">
    <h2 id="why-title">Why grassfed.food exists</h2>
    <p class="why-lede">Buying grass-fed straight from a farm should be simple, but labels blur, directories go stale and certifications are hard to check. We built this for home cooks, families buying a quarter or half of beef, and anyone who wants to know how their food was raised.</p>
    <ul class="pillars">
      <li>
        <span class="pillar-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="30" height="30" focusable="false"><circle cx="10.5" cy="10.5" r="6.2" fill="none" stroke="currentColor" stroke-width="1.9"/><path d="M15.2 15.2l5.3 5.3" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/><path d="M7.8 10.6l1.9 1.9 3.4-3.5" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
        <h3>Checked at the source</h3>
        <p>Every farm against its own website. Every certification with the certifier.</p>
      </li>
      <li>
        <span class="pillar-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="30" height="30" focusable="false"><rect x="3.5" y="5" width="17" height="15.5" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.9"/><path d="M3.5 9.8h17M8 3v4M16 3v4" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/><path d="M8.6 14.6l2.2 2.1 4.4-4.4" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
        <h3>Dated and rechecked</h3>
        <p>Every listing shows the day we last checked it. What we can't confirm comes down.</p>
      </li>
      <li>
        <span class="pillar-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="30" height="30" focusable="false"><circle cx="12" cy="12" r="8.6" fill="none" stroke="currentColor" stroke-width="1.9"/><path d="M14.4 9.3c-.5-.8-1.3-1.2-2.4-1.2-1.4 0-2.4.7-2.4 1.8 0 2.4 4.9 1.3 4.9 3.9 0 1.1-1 1.9-2.5 1.9-1.1 0-2-.5-2.5-1.3M12 6.6v1.5M12 15.7v1.6" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M5.9 5.9l12.2 12.2" stroke="currentColor" stroke-width="1.9" stroke-linecap="round"/></svg>
        </span>
        <h3>No paid placement</h3>
        <p>We take no money from farms or brands to be listed or ranked, and make no health claims.</p>
      </li>
    </ul>
    <p class="why-more"><a href="/about/">Read more about grassfed.food</a></p>
  </section>

  <section>
    <h2>What are you looking for?</h2>
    <ul class="species-row">
      {BROWSE.map((b) => (
        <li><a href={b.slug === 'dairy' ? '/dairy/' : `/browse/${b.slug}/`}><Icon name={b.icon} size={44} />{b.label}<small>{browseCounts[b.slug]} {browseCounts[b.slug] === 1 ? 'farm' : 'farms'}</small></a></li>
      ))}
    </ul>
  </section>

  <FeedingKey />

  {top3.length > 0 && (
    <section>
      <h2>Highest-rated farms</h2>
      <p class="muted">Best Google ratings among farms with more than {TOP_MIN_REVIEWS} reviews.</p>
      <ol class="top3">
        {top3.map((t) => (
          <li><a href={`/farm/${t.farm.slug}/`}>{t.farm.farm_name}</a><span class="muted small">{t.farm.city}, {t.farm.state}</span><GoogleRating slug={t.farm.slug} /></li>
        ))}
      </ol>
      <p><a href="/top-rated/">See the top 10</a></p>
    </section>
  )}

  <section>
    <h2>Farms by state</h2>
    <p class="muted">{farms.length} verified {farms.length === 1 ? 'farm' : 'farms'} based in {statesWithFarms} {statesWithFarms === 1 ? 'state' : 'states'} so far, with more added every week.</p>
    <TileMap />
  </section>

  <section aria-labelledby="listed-title">
    <h2 id="listed-title">How a farm gets listed</h2>
    <ol class="timeline">
      <li><span class="tl-line" aria-hidden="true"></span><h3>We find it</h3><p>Through certifier listings, USDA local food data, state agriculture programs, or the farm itself.</p></li>
      <li><span class="tl-line" aria-hidden="true"></span><h3>We check its own website</h3><p>What it sells, how it sells, and how it describes its feeding, in its own words.</p></li>
      <li><span class="tl-line" aria-hidden="true"></span><h3>We confirm certifications</h3><p>In the certifier's own public listing, before we show a badge.</p></li>
      <li><span class="tl-line" aria-hidden="true"></span><h3>We recheck every listing</h3><p>On a schedule, and date it. Anything we can't confirm comes down.</p></li>
    </ol>
    <p><a href="/methodology/">Read the full method</a></p>
  </section>

  {articles.length > 0 && (
    <section>
      <h2>Buying guides</h2>
      <ul class="article-list">
        {articles.map((a) => (
          <li><a href={`/guides/${a.id}/`}>{a.data.title}</a><p>{a.data.description}</p></li>
        ))}
      </ul>
    </section>
  )}
</Base>

<style>
  .why { margin: 2.75rem 0 0; }
  .why h2 { margin-top: 0; }
  .why-lede { max-width: 64ch; font-size: 1.05rem; color: var(--ink-soft); margin-bottom: 0; }
  .pillars { list-style: none; padding: 0; margin: 1.3rem 0 1rem; display: grid; gap: 0.85rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); }
  .pillars li { padding: 1.15rem 1.2rem 1.2rem; border-radius: var(--radius-md); background: rgba(255,255,255,0.72); border: 1px solid rgba(31,64,41,0.12); min-width: 0; }
  .pillar-icon { display: inline-grid; place-items: center; width: 54px; height: 54px; border-radius: 16px; color: var(--pasture-deep); background: linear-gradient(150deg, var(--clover), #e3ecd0); box-shadow: inset 0 1px 0 rgba(255,255,255,0.8); }
  .pillars li:nth-child(2) .pillar-icon { color: #6d4f0b; background: linear-gradient(150deg, #ecd9a4, var(--hay-tint)); }
  .pillars li:nth-child(3) .pillar-icon { color: var(--sky); background: linear-gradient(150deg, #cfe0ea, #e8f0f5); }
  .pillars h3 { margin: 0.8rem 0 0.3rem; font-size: 1.2rem; }
  .pillars p { margin: 0; color: var(--ink-soft); font-size: 0.97rem; line-height: 1.5; }
  .why-more { margin: 0; font-weight: 600; }

  .top3 { list-style: none; padding: 0; margin: 1rem 0; display: grid; gap: 0.75rem; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); counter-reset: r; }
  .top3 li { counter-increment: r; padding: 1rem 1.1rem; border-radius: var(--radius-md); background: rgba(255,255,255,0.72); border: 1px solid rgba(31,64,41,0.12); display: flex; flex-direction: column; gap: 0.2rem; }
  .top3 li::before { content: counter(r); font-family: var(--display); font-weight: 700; font-size: 1.6rem; color: var(--hay); line-height: 1; }
  .top3 a { font-family: var(--display); font-weight: 600; font-size: 1.2rem; color: var(--pasture-deep); text-decoration: none; }

  /* How a farm gets listed: a numbered timeline, down the page on phones, across on wide screens. */
  .timeline { list-style: none; padding: 0; margin: 1.25rem 0 1rem; counter-reset: step; display: grid; }
  .timeline li { position: relative; counter-increment: step; padding: 0 0 1.5rem 3.4rem; min-width: 0; }
  .timeline li::before {
    content: counter(step); position: absolute; left: 0; top: 0; z-index: 1;
    display: grid; place-items: center; width: 2.4rem; height: 2.4rem; border-radius: 50%;
    font: 700 1.1rem/1 var(--display); color: #fff;
    background: linear-gradient(180deg, #3b7346, var(--pasture-deep));
    box-shadow: 0 0 0 4px var(--paper), 0 4px 10px rgba(31,64,41,0.22);
  }
  .timeline li:last-child::before { background: linear-gradient(180deg, #c49324, var(--hay)); }
  .tl-line { position: absolute; left: calc(1.2rem - 1.5px); top: 2.4rem; bottom: 0; width: 3px; border-radius: 3px; background: linear-gradient(180deg, var(--pasture), var(--clover)); }
  .timeline li:last-child .tl-line { display: none; }
  .timeline h3 { margin: 0.4rem 0 0.25rem; font-size: 1.15rem; }
  .timeline p { margin: 0; color: var(--ink-soft); font-size: 0.97rem; line-height: 1.5; max-width: 46ch; }
  @media (min-width: 860px) {
    .timeline { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.25rem; }
    .timeline li { padding: 3.3rem 0 0; }
    .tl-line { left: 2.4rem; right: -1.25rem; top: calc(1.2rem - 1.5px); bottom: auto; width: auto; height: 3px; background: linear-gradient(90deg, var(--pasture), var(--clover)); }
  }
</style>
