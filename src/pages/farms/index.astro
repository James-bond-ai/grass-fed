---
import Base from '../../layouts/Base.astro';
import TileMap from '../../components/TileMap.astro';
import { STATES, INDEX_THRESHOLD } from '../../data/states.mjs';
import { loadPublishedFarms, farmsByState } from '../../data/farms.mjs';

const byState = farmsByState(loadPublishedFarms());
const counts = Object.fromEntries(Object.entries(byState).map(([k, v]) => [k, v.length]));
const sorted = STATES.slice().sort((a, b) => a.name.localeCompare(b.name));
const total = Object.values(counts).reduce((a, b) => a + b, 0);
---
<Base title="Grass-fed farms by state" description="Browse verified US farms selling grass-fed beef, lamb, bison, pork and dairy, state by state, with certifications and last-checked dates.">
  <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / Farms</nav>
  <h1>Grass-fed farms by state</h1>
  <p class="lede">{total} verified {total === 1 ? 'farm' : 'farms'} so far. Pick a state to see its farms and filter by what you want to buy.</p>
  <TileMap counts={counts} />
  <h2>All states</h2>
  <ul class="state-index">
    {sorted.map((s) => (
      <li><a href={`/farms/${s.slug}/`}>{s.name}</a> <span class="muted">{counts[s.abbr] ?? 0}</span></li>
    ))}
  </ul>
  <p class="small muted">State guides with fewer than {INDEX_THRESHOLD} verified farms are still being built. You can browse them, and we add farms every week.</p>
</Base>
<style>
  .state-index { columns: 3 200px; padding: 0; list-style: none; }
  .state-index li { padding: 0.25rem 0; break-inside: avoid; }
</style>
