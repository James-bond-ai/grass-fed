---
import Base from '../../layouts/Base.astro';
import Stamp from '../../components/Stamp.astro';
import FarmRow from '../../components/FarmRow.astro';
import { STATE_BY_ABBR, SPECIES, FEEDING, CHANNELS, CERTIFICATIONS, DAIRY_PRODUCTS, reach } from '../../data/states.mjs';
import { loadPublishedFarms } from '../../data/farms.mjs';
import { fmtDate } from '../../data/format.mjs';
import { getCollection } from 'astro:content';
import Icon from '../../components/Icon.astro';
import FeedingLabel from '../../components/FeedingLabel.astro';
import { BROWSE } from '../../data/browse.mjs';

export function getStaticPaths() {
  const all = loadPublishedFarms();
  return all.map((f) => ({ params: { slug: f.slug }, props: { farm: f, all } }));
}
const { farm, all } = Astro.props;
const st = STATE_BY_ABBR[farm.state];
const certs = (farm.certifications ?? []).filter((c) => CERTIFICATIONS[c.program]);
const claim = farm.feeding_claim ?? { category: 'unknown' };
const nearby = all.filter((f) => f.state === farm.state && f.slug !== farm.slug).slice(0, 5);
const KEYPAD: Record<string, string> = { A:'2',B:'2',C:'2',D:'3',E:'3',F:'3',G:'4',H:'4',I:'4',J:'5',K:'5',L:'5',M:'6',N:'6',O:'6',P:'7',Q:'7',R:'7',S:'7',T:'8',U:'8',V:'8',W:'9',X:'9',Y:'9',Z:'9' };
const telDigits = (p: string) => p.toUpperCase().replace(/[A-Z]/g, (c) => KEYPAD[c]).replace(/[^\d+]/g, '');
const host = (u: string) => { try { return new URL(u).hostname.replace(/^www\./, ''); } catch { return u; } };

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': farm.address_public ? 'LocalBusiness' : 'Organization',
    name: farm.farm_name,
    url: farm.website,
    ...(farm.phone ? { telephone: farm.phone } : {}),
    address: {
      '@type': 'PostalAddress',
      ...(farm.address_public && farm.address ? { streetAddress: farm.address } : {}),
      addressLocality: farm.city,
      addressRegion: farm.state,
      ...(farm.zip ? { postalCode: farm.zip } : {}),
      addressCountry: 'US',
    },
    ...(farm.lat && farm.lng ? { geo: { '@type': 'GeoCoordinates', latitude: farm.lat, longitude: farm.lng } } : {}),
    ...(farm.social_urls?.length ? { sameAs: farm.social_urls } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://grassfed.food/' },
      { '@type': 'ListItem', position: 2, name: st.name, item: `https://grassfed.food/farms/${st.slug}/` },
      { '@type': 'ListItem', position: 3, name: farm.farm_name, item: `https://grassfed.food/farm/${farm.slug}/` },
    ],
  },
];
const species = (farm.species ?? []).map((s) => SPECIES[s] ?? s);
const r = reach(farm);
const rawGuide = (await getCollection('articles')).some((a) => a.id === 'raw-milk-laws-by-state');
const shipsList = [...r.shipsTo].map((a) => STATE_BY_ABBR[a]?.name ?? a);
const hasReach = r.nationwide || shipsList.length || r.localAreas.length || r.radius || r.pickup.length;
const photos = (farm.photos ?? []).filter((p) => p.permission);
const icons = BROWSE.filter((b) => (farm.species ?? []).some((x) => b.species.includes(x)));
const description = `${farm.farm_name} in ${farm.city}, ${st.name}${species.length ? ` sells ${species.slice(0, 3).join(', ').toLowerCase()}` : ''}. Feeding claims, certifications and how to buy, last checked ${fmtDate(farm.last_verified_at)}.`;
---
<Base title={`${farm.farm_name}, ${farm.city}, ${st.abbr}`} description={description.slice(0, 165)} jsonLd={jsonLd}>
  <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <a href="/farms/">Farms</a> / <a href={`/farms/${st.slug}/`}>{st.name}</a> / {farm.farm_name}</nav>
  <div class="head">
    <div>
      <h1>{farm.farm_name}</h1>
      <p class="lede">{farm.city}, {st.name}</p>
      <FeedingLabel farm={farm} size="lg" showNote />
      {icons.length > 0 && <ul class="farm-icons" aria-label="Sells">{icons.map((b) => <li title={b.label}><Icon name={b.icon} size={34} /><span>{b.label}</span></li>)}</ul>}
    </div>
    <Stamp date={farm.last_verified_at} />
  </div>

  {photos.length > 0 && (
    <div class="farm-photos">
      {photos.map((p) => (
        <figure><img src={p.src} alt={p.alt} loading="lazy" width="640" height="480" /><figcaption>Photo: {p.credit}</figcaption></figure>
      ))}
    </div>
  )}
  <section class="prose">
    <h2>How the farm describes its feeding</h2>
    {claim.verbatim ? (
      <>
        <p class="claim">{claim.verbatim}</p>
        <p class="small muted">How the farm describes it on {claim.source_url ? <a href={claim.source_url} rel="nofollow">{host(claim.source_url)}</a> : 'its website'}, as of {fmtDate(farm.last_verified_at)}. Our summary: {FEEDING[claim.category] ?? FEEDING.unknown}. {certs.length ? '' : 'Farm-reported; not independently certified.'}</p>
      </>
    ) : (
      <p>The farm's website doesn't describe its feeding in detail. Ask the farm directly how animals are fed and finished.</p>
    )}

    <h2>Certifications</h2>
    {certs.length ? (
      <ul>
        {certs.map((c) => (
          <li><strong>{CERTIFICATIONS[c.program].name}</strong>{
            c.program === 'usda-organic' ? <>, certified by {c.body}. The farm's animals are certified organic, so its meat, eggs or milk can be sold as organic. Confirmed in the <a href={c.evidence_url} rel="nofollow">USDA Organic Integrity Database</a> on {fmtDate(c.verified_on)}.</>
            : c.program === 'usda-organic-dairy' ? <>, certified by {c.body}. These dairy products are certified organic: {(c.products ?? []).map((p) => DAIRY_PRODUCTS[p] ?? p).join(', ')}. The farm's animals are not certified. Confirmed in the <a href={c.evidence_url} rel="nofollow">USDA Organic Integrity Database</a> on {fmtDate(c.verified_on)}.</>
            : c.program === 'usda-organic-pasture' ? <>, certified by {c.body}. The farm's pasture or hay is certified organic, but its animals are not, so its meat and milk can't be sold as organic. Confirmed in the <a href={c.evidence_url} rel="nofollow">USDA Organic Integrity Database</a> on {fmtDate(c.verified_on)}.</>
            : <>. Confirmed in the <a href={c.evidence_url} rel="nofollow">certifier's listing</a> on {fmtDate(c.verified_on)}.</>}</li>
        ))}
      </ul>
    ) : (
      <p>We didn't find this farm in any certifier's public listing. That doesn't mean its practices fall short; many small farms sell direct without certification. <a href="/certifications/">What the certifications mean</a></p>
    )}

    <h2>Delivery, shipping and pickup</h2>
    {hasReach ? (
      <div class="reach">
        <dl>
          {r.localAreas.length > 0 && <><dt>Delivers to</dt><dd>{r.localAreas.join('; ')}</dd></>}
          {r.radius && <><dt>Delivery range</dt><dd>Within about {r.radius} miles of the farm</dd></>}
          <dt>Ships to</dt><dd>{r.nationwide ? 'Anywhere in the continental US' : shipsList.length ? shipsList.join(', ') : 'Does not ship, or not stated'}</dd>
          {r.pickup.length > 0 && <><dt>Pickup</dt><dd>{r.pickup.join('; ')}</dd></>}
        </dl>
        {farm.delivery?.source_url && <p class="small muted" style="margin:0.75rem 0 0">From the farm's <a href={farm.delivery.source_url} rel="nofollow">delivery information</a>. Delivery areas and fees change; check with the farm.</p>}
      </div>
    ) : (
      <p>The farm's website doesn't say where it delivers or ships. Contact the farm to ask.</p>
    )}

    <h2>What they sell and how to buy</h2>
    <dl class="facts">
      {species.length > 0 && <><dt>Animals</dt><dd>{species.join(', ')}</dd></>}
      {farm.products?.length > 0 && <><dt>Products</dt><dd>{farm.products.join(', ')}</dd></>}
      {farm.dairy_products?.length > 0 && <><dt>Dairy</dt><dd>{farm.dairy_products.map((d) => DAIRY_PRODUCTS[d] ?? d).join(', ')}{farm.dairy_products.includes('raw-milk') && <> (raw milk is legal to sell only in some states{rawGuide ? <>; <a href="/guides/raw-milk-laws-by-state/">see the rules</a></> : ''})</>}</dd></>}
      <dt>Bulk shares</dt><dd>{farm.bulk_shares ? 'Sells quarter, half or whole animals' : 'Not offered or not stated'}</dd>
      {farm.sales_channels?.length > 0 && <><dt>Ways to buy</dt><dd>{farm.sales_channels.map((c) => CHANNELS[c] ?? c).join(', ')}</dd></>}
      {farm.farmers_markets?.length > 0 && <><dt>Farmers markets</dt><dd>{farm.farmers_markets.join(', ')}</dd></>}
      <dt>Website</dt><dd><a href={farm.website} rel="nofollow">{host(farm.website)}</a></dd>
      {farm.ordering_url && <><dt>Order online</dt><dd><a href={farm.ordering_url} rel="nofollow">{host(farm.ordering_url)}</a></dd></>}
      {farm.phone && <><dt>Phone</dt><dd><a href={`tel:${telDigits(farm.phone)}`}>{farm.phone}</a></dd></>}
      {farm.address_public && farm.address && <><dt>Address</dt><dd>{farm.address.includes(farm.city) ? farm.address : `${farm.address}, ${farm.city}, ${farm.state} ${farm.zip ?? ''}`.trim()}</dd></>}
    </dl>
    <p class="small muted">Last checked against the farm's website on {fmtDate(farm.last_verified_at)}. Products, prices and availability change; confirm with the farm before you buy. Something wrong? <a href="/corrections/">Report a correction</a>.</p>
  </section>

  {nearby.length > 0 && (
    <section>
      <h2>More farms in {st.name}</h2>
      <ul class="farm-list">{nearby.map((f) => <FarmRow farm={f} showState={false} />)}</ul>
      <p><a href={`/farms/${st.slug}/`}>All {st.name} farms</a></p>
    </section>
  )}
</Base>
<style>
  .head { display: flex; justify-content: space-between; align-items: flex-start; gap: 1.5rem; flex-wrap: wrap; }
  .head .stamp { font-size: 1.1rem; margin-top: 0.5rem; }
  .farm-icons { list-style: none; display: flex; flex-wrap: wrap; gap: 1.25rem; padding: 0; margin: 0.5rem 0 0; }
  .farm-icons li { display: flex; align-items: center; gap: 0.4rem; font-size: 0.9rem; color: var(--ink-soft); }
</style>
